<Window x:Class="WindowsTimer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsTimer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Icon="/Resources/app.ico"
        Width="420"
        Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Topmost="{Binding AlwaysOnTop}"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="22,14,22,18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <TextBlock Text="Timer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PinButton}" Content="&#xE718;" Command="{Binding ToggleTopmostCommand}"
                            ToolTip="Always on top" AutomationProperties.Name="Always on top"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings" AutomationProperties.Name="Settings"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="Minimize_OnClick"
                            ToolTip="Hide to notification area" AutomationProperties.Name="Minimize"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="Close_OnClick"
                            ToolTip="Close" AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="250" Height="250">
                    <controls:RingProgress Progress="{Binding RingProgress}" Thickness="8"
                                           TrackBrush="{DynamicResource TrackBrush}"
                                           IndicatorBrush="{DynamicResource AccentBrush}"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DisplayTime}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="44" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding CanEditTime, Converter={StaticResource InverseBoolToVis}}"/>
                        <Grid Visibility="{Binding CanEditTime, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="68"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource TimeBox}"
                                     Text="{Binding HoursText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Hours" AutomationProperties.Name="Hours"
                                     PreviewTextInput="TimeBox_OnPreviewTextInput"
                                     GotKeyboardFocus="TimeBox_OnGotKeyboardFocus"
                                     LostKeyboardFocus="TimeBox_OnLostKeyboardFocus"/>
                            <TextBlock Grid.Column="1" Text=":" FontSize="32" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox Grid.Column="2" Style="{StaticResource TimeBox}"
                                     Text="{Binding MinutesText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Minutes" AutomationProperties.Name="Minutes"
                                     PreviewTextInput="TimeBox_OnPreviewTextInput"
                                     GotKeyboardFocus="TimeBox_OnGotKeyboardFocus"
                                     LostKeyboardFocus="TimeBox_OnLostKeyboardFocus"/>
                            <TextBlock Grid.Column="3" Text=":" FontSize="32" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBox Grid.Column="4" Style="{StaticResource TimeBox}"
                                     Text="{Binding SecondsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Seconds" AutomationProperties.Name="Seconds"
                                     PreviewTextInput="TimeBox_OnPreviewTextInput"
                                     GotKeyboardFocus="TimeBox_OnGotKeyboardFocus"
                                     LostKeyboardFocus="TimeBox_OnLostKeyboardFocus"/>
                        </Grid>
                        <Grid Margin="0,2,0,0" Visibility="{Binding CanEditTime, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="68"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="68"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="hrs" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="min" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <TextBlock Grid.Column="4" Text="sec" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="4,8,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding PrimaryActionLabel}" Command="{Binding ToggleCommand}"
                        Style="{StaticResource PrimaryButton}" ToolTip="Start or pause (Space)"
                        AutomationProperties.Name="Start or pause"/>
                <Button Grid.Column="2" Content="Reset" Command="{Binding ResetCommand}"
                        Style="{StaticResource SecondaryButton}" ToolTip="Reset (R)"
                        AutomationProperties.Name="Reset"/>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,22,0,0">
                <TextBlock Text="QUICK START" Style="{StaticResource SectionLabel}" Margin="8,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" ToolTip="{Binding ToolTip}"
                                    Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Minutes}"
                                    AutomationProperties.Name="{Binding ToolTip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PresetButton}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource PresetMatch}">
                                                        <Binding Path="Minutes"/>
                                                        <Binding Path="DataContext.SelectedPresetMinutes" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Button Grid.Row="4" Content="Mini timer" Command="{Binding ToggleMiniCommand}"
                    Style="{StaticResource TextActionButton}" HorizontalAlignment="Center" Margin="0,8,0,0"
                    ToolTip="Open a compact floating timer" AutomationProperties.Name="Mini timer"/>
        </Grid>
    </Border>
</Window>
