<Window x:Class="WindowsTimer.Views.MiniTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Timer"
        Icon="/Resources/app.ico"
        Width="286"
        Height="84"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="{Binding AlwaysOnTop}"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="16,0"
            MouseLeftButtonDown="Surface_OnMouseLeftButtonDown" Background="Transparent">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding DisplayTime}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="{Binding PrimaryGlyph}"
                        Command="{Binding ToggleCommand}" ToolTip="Start or pause" AutomationProperties.Name="Start or pause"/>
                <Button Style="{StaticResource PinButton}" Content="&#xE718;" Command="{Binding ToggleTopmostCommand}"
                        ToolTip="Always on top" AutomationProperties.Name="Always on top"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE922;" Click="Expand_OnClick"
                        ToolTip="Expand" AutomationProperties.Name="Expand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
