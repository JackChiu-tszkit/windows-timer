<Window x:Class="WindowsTimer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Icon="/Resources/app.ico"
        Width="420"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="52" Margin="22,8,14,0" MouseLeftButtonDown="Title_OnMouseLeftButtonDown">
                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                        Click="Done_OnClick" ToolTip="Close" AutomationProperties.Name="Close settings"/>
            </Grid>
            <Button DockPanel.Dock="Bottom" Content="Done" Margin="48,8,48,20" Click="Done_OnClick"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True"
                    AutomationProperties.Name="Done"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,0,22,8">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" Margin="0,8,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="System" GroupName="Theme" Style="{StaticResource ChoiceChip}"
                                     IsChecked="{Binding IsThemeSystem}"/>
                        <RadioButton Content="Light" GroupName="Theme" Style="{StaticResource ChoiceChip}"
                                     IsChecked="{Binding IsThemeLight}"/>
                        <RadioButton Content="Dark" GroupName="Theme" Style="{StaticResource ChoiceChip}"
                                     IsChecked="{Binding IsThemeDark}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HelpText}" Text="System follows the Windows app theme."/>

                    <TextBlock Text="SOUND" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Bell" GroupName="Sound" Style="{StaticResource ChoiceChip}"
                                     IsChecked="{Binding IsSoundBell}"/>
                        <RadioButton Content="Chime" GroupName="Sound" Style="{StaticResource ChoiceChip}"
                                     IsChecked="{Binding IsSoundChime}"/>
                        <RadioButton Content="Soft" GroupName="Sound" Style="{StaticResource ChoiceChip}"
                                     IsChecked="{Binding IsSoundSoft}"/>
                    </StackPanel>
                    <Button Content="Preview sound" HorizontalAlignment="Left" Command="{Binding PreviewCommand}"
                            Style="{StaticResource TextActionButton}" Margin="0,0,0,8" AutomationProperties.Name="Preview sound"/>
                    <DockPanel Margin="0,4,0,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Width="42" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding VolumePercent, StringFormat={}{0:0}%}"/>
                        <Slider Style="{StaticResource VolumeSlider}" Margin="0,0,8,0"
                                AutomationProperties.Name="Notification volume"
                                Value="{Binding VolumePercent, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <CheckBox Content="Mute" Style="{StaticResource SwitchBox}" IsChecked="{Binding IsMuted}" Margin="0,12,0,0"/>
                    <CheckBox Content="Repeat until dismissed" Style="{StaticResource SwitchBox}"
                              IsChecked="{Binding RepeatUntilDismissed}"/>
                    <TextBlock Style="{StaticResource HelpText}" Text="The default volume is intentionally moderate."/>

                    <TextBlock Text="WINDOW" Style="{StaticResource SectionLabel}"/>
                    <CheckBox Content="Always on top" Style="{StaticResource SwitchBox}" IsChecked="{Binding AlwaysOnTop}"/>
                    <TextBlock Text="When closing" Style="{StaticResource HelpText}" Margin="0,10,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Exit" GroupName="Close" Style="{StaticResource ChoiceChip}"
                                     IsChecked="{Binding CloseExits}"/>
                        <RadioButton Content="Minimize to tray" GroupName="Close" Style="{StaticResource ChoiceChip}"
                                     IsChecked="{Binding CloseMinimizes}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HelpText}"
                               Text="Minimize keeps the countdown running in the notification area. Exit quits Timer. The minimize button always hides to the notification area."/>

                    <TextBlock Text="STARTUP" Style="{StaticResource SectionLabel}"/>
                    <CheckBox Content="Launch when Windows starts" Style="{StaticResource SwitchBox}"
                              IsChecked="{Binding LaunchOnStartup}"/>
                    <TextBlock Style="{StaticResource HelpText}" Text="No account is required. Settings stay on this PC."/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
