<Window x:Class="WindowsTimer.Views.TimeUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Time's up"
        Icon="/Resources/app.ico"
        Width="360"
        Height="280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="00:00" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"
                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock Text="Time's up" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="Your countdown has finished." FontSize="14" HorizontalAlignment="Center"
                           Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <Button x:Name="DismissButton" Grid.Row="1" Content="Dismiss" Margin="40,0,40,0"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" IsCancel="True" Click="Dismiss_OnClick"
                    AutomationProperties.Name="Dismiss"/>
        </Grid>
    </Border>
</Window>
